# Copy this file to .env.user and fill in your own values.
# .env.user is gitignored; this template is tracked.

# --- Identity / machine ---
USER_NAME=your-username
MACHINE_HOSTNAME=your-machine-name
OS_NAME=macOS
OS_VERSION=
OS_BUILD=
ARCH=arm64
PYTHON_PATH=/usr/bin/python3
PYTHON_VERSION=

# --- After Effects ---
AE_VERSION=Adobe After Effects 2026

# --- AEGraph paths ---
AEGRAPH_PATH=/path/to/aegraph
# Leave blank to fall back to the package jsx_output/ directory.
JSX_OUTPUT_DIR=
